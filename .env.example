# eAbot environment template
# Copy to .env.local and add credentials. Never commit real values.
# Variables without VITE_ are server-only and must be read by Vercel Functions.

VITE_APP_ENV=development
VITE_API_MODE=mock
VITE_EABOT_API_BASE_URL=/api

# eGov SSO
EGOV_SSO_API_BASE_URL=
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=

# National ID eVerify
EVERIFY_API_BASE_URL=
EVERIFY_CLIENT_ID=
EVERIFY_CLIENT_SECRET=
EVERIFY_PUBLIC_KEY=

# eMessage
EMESSAGE_API_BASE_URL=
EMESSAGE_ACCESS_TOKEN=

# eGov AI
EGOV_AI_API_BASE_URL=
EGOV_AI_ACCESS_CODE=

# eGovPay
EGOVPAY_API_BASE_URL=
EGOVPAY_API_KEY=
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=
EGOVPAY_WEBHOOK_SECRET=
EGOVPAY_APP_URL=

# eReport
EREPORT_API_BASE_URL=
EREPORT_ACCESS_TOKEN=

# Face Liveness
FACE_LIVENESS_API_BASE_URL=
FACE_LIVENESS_API_KEY=

# DBM COMPASS
COMPASS_API_BASE_URL=
COMPASS_API_KEY=

# Document and receipt services required by the eAbot request journey
GOV_DOCUMENT_API_BASE_URL=
GOV_DOCUMENT_API_KEY=
EGOV_RECEIPT_API_BASE_URL=
EGOV_RECEIPT_API_KEY=
